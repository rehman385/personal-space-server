# Render runtime
NODE_ENV=production
PORT=10000
RENDER_EXTERNAL_URL=https://personal-space-backend.onrender.com
HEARTBEAT_ENABLED=true
# Optional override (defaults to RENDER_EXTERNAL_URL)
HEARTBEAT_URL=https://personal-space-backend.onrender.com

# TiDB Cloud connection
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=NwDjC169PaPfkZB.root
DB_PASSWORD=Y4k9fMZLKhUPRiSm
DB_NAME=personal_space

# TLS for TiDB Cloud
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=/etc/secrets/ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Pool tuning
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=15000

# Auth secret
JWT_SECRET=replace_with_a_long_random_secret
